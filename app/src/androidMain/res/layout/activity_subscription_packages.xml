<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Choose Package"
            app:titleTextColor="@color/on_surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:background="@android:color/transparent"
            app:elevation="0dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shop Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_variant"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shop Subscription"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_store" />

                    <TextView
                        android:id="@+id/tvShopName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Shop Name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:id="@+id/tvCurrentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Status: Not Activated"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Packages Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a Package"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="16dp" />

            <!-- Basic Package Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/gray_300"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Package Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_package_basic"
                            android:tint="@color/blue_500"
                            android:contentDescription="Basic Package" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvBasicName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BASIC"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface" />

                            <TextView
                                android:id="@+id/tvBasicDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perfect for small businesses"
                                android:textSize="12sp"
                                android:textColor="@color/on_surface_variant"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBasicTrial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 MONTH FREE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_trial_badge"
                            android:textColor="@color/white"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                    <!-- Price -->
                    <TextView
                        android:id="@+id/tvBasicPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UGX 20,000 /mo"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="8dp" />

                    <!-- Features -->
                    <TextView
                        android:id="@+id/tvBasicFeatures"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Inventory\n• Reports\n• Support"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Select Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectBasic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SELECT BASIC"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/blue_500"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_check"
                        app:iconPadding="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Pro Package Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/purple_500"
                app:strokeWidth="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Popular Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POPULAR"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_popular_badge"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginBottom="12dp"
                        android:layout_gravity="end" />

                    <!-- Package Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_package_pro"
                            android:tint="@color/purple_500"
                            android:contentDescription="Pro Package" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvProName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRO"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface" />

                            <TextView
                                android:id="@+id/tvProDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Advanced features for growth"
                                android:textSize="12sp"
                                android:textColor="@color/on_surface_variant"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Price -->
                    <TextView
                        android:id="@+id/tvProPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UGX 50,000 /mo"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_500"
                        android:layout_marginBottom="8dp" />

                    <!-- Features -->
                    <TextView
                        android:id="@+id/tvProFeatures"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Inventory\n• Reports\n• Support\n• Analytics"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Select Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectPro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SELECT PRO"
                        style="@style/Widget.Material3.Button"
                        app:backgroundTint="@color/purple_500"
                        app:icon="@drawable/ic_star"
                        app:iconPadding="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Popular (Enterprise) Package Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPopular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/gray_300"
                app:strokeWidth="1dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Package Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_package_enterprise"
                            android:tint="@color/orange_500"
                            android:contentDescription="Enterprise Package" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvPopularName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ENTERPRISE"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface" />

                            <TextView
                                android:id="@+id/tvPopularDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Custom solutions for enterprises"
                                android:textSize="12sp"
                                android:textColor="@color/on_surface_variant"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Custom Price -->
                    <TextView
                        android:id="@+id/tvPopularPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom Pricing"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange_500"
                        android:layout_marginBottom="8dp" />

                    <!-- Features -->
                    <TextView
                        android:id="@+id/tvPopularFeatures"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Inventory\n• Reports\n• Support\n• API Access"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Select Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectPopular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONTACT SALES"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/orange_500"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_chat"
                        app:iconPadding="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Info Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All plans include 24/7 support and regular updates. Cancel anytime."
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:padding="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>