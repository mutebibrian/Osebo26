<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:title="Payment Status"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Status Icon -->
        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_pending"
            android:layout_marginBottom="24dp"
            app:tint="@color/yellow_500" />

        <!-- Status Title -->
        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Pending"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Status Message -->
        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please follow the prompts on your phone"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Transaction Details -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transaction Details"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvTransactionId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transaction ID: --"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount: --"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Polling Progress -->
        <ProgressBar
            android:id="@+id/pbPolling"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/primary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvPollingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking payment status..."
            android:textSize="14sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvNextCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next check in 5 seconds"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant" />

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTryAgain"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="TRY AGAIN"
            android:layout_marginTop="32dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewSubscription"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VIEW SUBSCRIPTION"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>