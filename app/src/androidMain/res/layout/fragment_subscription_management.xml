<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".fragments.SubscriptionManagementFragment">

    <!-- Toolbar - THIS IS WHAT WAS MISSING -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Manage Subscription" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- Error Message -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Error loading subscription"
        android:textColor="@color/error_red"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- ScrollView for content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Content Layout (shown when subscription exists) -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Current Plan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Plan"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/tvPlanName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pro Plan"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                tools:text="Enterprise Plan" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTIVE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/success_green"
                                android:textColor="@android:color/white"
                                tools:text="TRIAL"
                                tools:backgroundTint="@color/warning_orange" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPlanNameDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pro Plan - Monthly Billing"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="16dp"
                            tools:text="Enterprise Plan - Yearly Billing" />

                        <TextView
                            android:id="@+id/tvAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$49.99/month"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/success_green"
                            android:layout_marginBottom="16dp"
                            tools:text="$99.99/month" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginBottom="16dp" />

                        <!-- Subscription Details Grid -->
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="3"
                            android:layout_marginBottom="16dp">

                            <!-- Start Date -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_gravity="fill"
                                android:text="Start Date:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:layout_marginBottom="12dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvStartDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_gravity="fill"
                                android:text="Jan 15, 2024"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"
                                android:layout_marginStart="8dp"
                                tools:text="Jan 15, 2024" />

                            <!-- End Date -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_gravity="fill"
                                android:text="End Date:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:layout_marginBottom="12dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvEndDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_gravity="fill"
                                android:text="Dec 31, 2024"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"
                                android:layout_marginStart="8dp"
                                tools:text="Dec 31, 2024" />

                            <!-- Days Remaining -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_gravity="fill"
                                android:text="Days Left:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvDaysRemaining"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_gravity="fill"
                                android:text="30 days"
                                android:textColor="@color/success_green"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp"
                                tools:text="30 days" />

                        </GridLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payment Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment Information"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp" />

                        <!-- Payment Method -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Payment Method:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvPaymentMethod"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mobile Money"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="Mobile Money" />
                        </LinearLayout>

                        <!-- Billing Cycle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Billing Cycle:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvBillingCycle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Monthly"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="Monthly" />
                        </LinearLayout>

                        <!-- Last Payment -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Last Payment:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvLastPayment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Jan 15, 2024"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="Jan 15, 2024" />
                        </LinearLayout>

                        <!-- Next Billing -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Next Billing:"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvNextBilling"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Feb 15, 2024"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="Feb 15, 2024" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Auto Renew Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Auto Renew Enabled Layout -->
                        <LinearLayout
                            android:id="@+id/layoutAutoRenewEnabled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Auto-renew is ENABLED"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/success_green" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDisableAutoRenew"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Disable"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    app:strokeColor="@color/error_red"
                                    android:textColor="@color/error_red" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAutoRenewDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Next billing: Feb 15, 2024"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                tools:text="Next billing: Feb 15, 2024" />
                        </LinearLayout>

                        <!-- Auto Renew Disabled Layout -->
                        <LinearLayout
                            android:id="@+id/layoutAutoRenewDisabled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="visible"
                            tools:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Auto-renew is DISABLED"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/error_red" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnEnableAutoRenew"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Enable"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    app:strokeColor="@color/success_green"
                                    android:textColor="@color/success_green" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your subscription will expire on Dec 31, 2024"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                tools:text="Your subscription will expire on Dec 31, 2024" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRenewSubscription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Renew Subscription"
                        style="@style/Widget.Material3.Button"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpgradeSubscription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upgrade Plan"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change Payment Method"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewBillingHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Billing History"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelSubscription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cancel Subscription"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:textColor="@color/error_red" />
                </LinearLayout>

            </LinearLayout>

            <!-- No Subscription Layout -->
            <LinearLayout
                android:id="@+id/layoutNoSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_subscription_required"
                            android:tint="@color/gray_400"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Active Subscription"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subscribe to a plan to access premium features"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginBottom="24dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubscribeNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subscribe Now"
                            style="@style/Widget.Material3.Button" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>