<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_grey"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Shop Info Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shops · Shop Billing"
                android:textSize="14sp"
                android:textColor="@color/grey_600"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                tools:text="BK Enterprise" />
        </LinearLayout>

        <!-- Overview / History Tabs -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/grey_200"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabOverviewButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overview"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_list"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabHistoryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="History"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_sort"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="16dp">

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Error Text -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error loading plans"
                android:textColor="@color/error_red"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="gone" />

            <!-- Retry Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:layout_constraintTop_toBottomOf="@id/errorText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="gone" />

            <!-- Section label -->
            <TextView
                android:id="@+id/overviewSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHOP SUBSCRIPTION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/grey_600"
                android:letterSpacing="0.05"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/overviewSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subscription Overview"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/overviewSectionLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/topActionButtonsRow" />

            <!-- Manage Bundles / Renew Bundles — always-visible actions matching the web billing screen -->
            <LinearLayout
                android:id="@+id/topActionButtonsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="@id/overviewSectionLabel"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageBundles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Bundles"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:backgroundTint="@color/success_green"
                    style="@style/Widget.MaterialComponents.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRenewBundlesActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Renew Bundles"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

            <!-- Active Bundles Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/activeBundlesCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/grey_200"
                app:strokeWidth="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/overviewSectionTitle"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE BUNDLES"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/grey_600"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvActiveBundles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"
                        tools:text="0" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- No Subscription State -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/noSubscriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/activeBundlesCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/emptyStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No active subscriptions found for this shop."
                    android:textSize="14sp"
                    android:textColor="@color/grey_700"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Buttons row: Start Free Trial / Manage Bundles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    app:layout_constraintTop_toBottomOf="@id/emptyStateTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/subscribeNowButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start Free Trial"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/success_green"
                        style="@style/Widget.MaterialComponents.Button"
                        tools:text="Start Free Trial" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Subscription Details (at-a-glance header only) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/subscriptionDetailsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/activeBundlesCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Plan Name and Status Chip -->
                <LinearLayout
                    android:id="@+id/planHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/planNameTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pro Plan"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        tools:text="Pro Plan" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        app:chipBackgroundColor="@color/success_green"
                        android:textColor="@color/white"
                        app:chipCornerRadius="16dp"
                        android:textSize="12sp"
                        tools:text="Active" />
                </LinearLayout>

                <!-- Price -->
                <TextView
                    android:id="@+id/priceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UGX 20,000 / month"
                    android:textSize="20sp"
                    android:textColor="@color/primary_color"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/planHeader"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Expiry Section -->
                <LinearLayout
                    android:id="@+id/expirySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintTop_toBottomOf="@id/priceTextView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/expiresValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mar 19, 2026"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginEnd="16dp"
                        tools:text="Mar 19, 2026" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/daysLeftValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 days left"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/success_green"
                        tools:text="14 days left" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Current Bundle Access — matches web's "Subscribed Bundles" table -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bundleAccessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/grey_200"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/subscriptionDetailsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUBSCRIBED BUNDLES"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/grey_600"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Bundle Access"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="These are the active bundles currently available to this shop."
                        android:textSize="13sp"
                        android:textColor="@color/grey_600"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Table header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="BUNDLE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/grey_600" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="TYPE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/grey_600" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ENDS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/grey_600" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="MONTHLY RATE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/grey_600" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="ACTION"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/grey_600"
                            android:gravity="end" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_200"
                        android:layout_marginBottom="12dp" />

                    <!-- Data row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tvBundleName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Basic"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            tools:text="Basic" />

                        <TextView
                            android:id="@+id/tvBundleType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="BASE"
                            android:textSize="12sp"
                            android:textColor="@color/grey_600"
                            tools:text="BASE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBundleEnds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sep 16, 2026"
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                tools:text="Sep 16, 2026" />

                            <TextView
                                android:id="@+id/tvBundleDaysLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6 days left"
                                android:textSize="11sp"
                                android:textColor="@color/grey_600"
                                tools:text="6 days left" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBundleMonthlyRate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="UGX 20,000"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            tools:text="UGX 20,000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelRenewal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Cancel Renewal"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_200"
                        android:layout_marginBottom="12dp" />

                    <!-- Monthly total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Monthly bundle total cost:"
                            android:textSize="13sp"
                            android:textColor="@color/grey_700" />

                        <TextView
                            android:id="@+id/tvMonthlyTotalCost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 20,000"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            tools:text="UGX 20,000" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Available Plans Section -->
            <TextView
                android:id="@+id/plansSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Plans"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/bundleAccessCard"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Plans RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/plansRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/plansSectionTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Checkout button for selected bundles from the plans list -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckoutSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checkout Selected Bundles"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/plansRecyclerView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Contact Sales Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contactSalesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnCheckoutSelected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_sales"
                        android:tint="@color/primary_color"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Need a custom plan?"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact our sales team for enterprise solutions"
                            android:textSize="12sp"
                            android:textColor="@color/grey_600" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/contactSalesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
