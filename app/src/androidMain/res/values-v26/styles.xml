<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Osebo2.Chip.Choice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textColor">@color/black</item>
        <item name="chipBackgroundColor">@drawable/chip_background_selector</item>
        <item name="chipStrokeColor">@drawable/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipIconTint">@color/primary</item>
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconSize">20dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>

    <style name="Widget.Osebo2.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/grey_700</item>
        <item name="strokeColor">@color/grey_400</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
</resources>