<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- Content wrapper: DrawerLayout treats any direct child whose layout_gravity has a
         left/right (or start/end) component as a drawer view, not a positioned overlay. The
         FABs and progress overlay below use gravity to position themselves, so they must live
         inside a single non-gravity content child instead of directly under DrawerLayout -
         otherwise DrawerLayout mistakes each of them for another drawer along the same edge
         and crashes ("Child drawer has absolute gravity RIGHT..."). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@drawable/bg_dashboard_header_gradient"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
                app:titleTextColor="@android:color/white"
                app:title="Osebo">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/flNotificationBell"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Notifications">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notifications"
                            app:tint="@android:color/white" />

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="7dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_notification_badge" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/flAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Account">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            android:background="@drawable/bg_avatar_white_circle"
                            android:padding="6dp"
                            app:tint="@color/primary" />
                    </FrameLayout>
                </LinearLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <!-- NavHostFragment Container -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_container"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_graph" />

            <!-- Global Bottom Navigation -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNavMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_nav_background"
                app:elevation="8dp"
                app:itemIconTint="@color/bottom_nav_selector"
                app:itemTextColor="@color/bottom_nav_selector"
                app:itemRippleColor="@color/primary_10"
                app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
                app:itemIconSize="24dp"
                app:itemTextAppearanceActive="@style/BottomNavTextActive"
                app:itemTextAppearanceInactive="@style/BottomNavTextInactive"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:menu="@menu/main_bottom_nav_menu"
                app:labelVisibilityMode="labeled" />
        </LinearLayout>

        <!-- FloatingActionButtons -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/mainFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="96dp"
            android:contentDescription="Quick Actions"
            app:backgroundTint="@color/primary"
            app:srcCompat="@drawable/ic_add" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="168dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:backgroundTint="@color/green_500"
            app:srcCompat="@drawable/ic_sale" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="240dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:backgroundTint="@color/blue_500"
            app:srcCompat="@drawable/ic_product" />

        <!-- Progress Overlay -->
        <FrameLayout
            android:id="@+id/progressOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="true">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>

    <!-- ===== NavigationView with Custom Header ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@android:color/white"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_menu"
        app:itemBackground="@drawable/bg_drawer_item"
        app:itemTextColor="@color/drawer_item_text"
        app:itemIconTint="@color/drawer_item_text"
        app:itemIconPadding="16dp" />

</androidx.drawerlayout.widget.DrawerLayout>