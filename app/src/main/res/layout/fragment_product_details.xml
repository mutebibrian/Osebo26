<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    tools:context=".fragments.ProductDetailsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Product Details"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:menu="@menu/menu_product_details" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Network Status Bar - ADD THIS -->
    <TextView
        android:id="@+id/tv_network_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:visibility="gone"
        android:gravity="center"
        app:layout_anchor="@id/appBarLayout"
        app:layout_anchorGravity="bottom" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/iv_product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_product_placeholder"
                    android:padding="40dp"
                    app:tint="@color/colorPrimary" />
            </androidx.cardview.widget.CardView>

            <!-- Product Name and SKU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_product_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="iPhone 15 Pro"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_product_sku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SKU: IP15P-256"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="bottom" />
            </LinearLayout>

            <!-- Category and Supplier -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Electronics"
                    android:drawableStart="@drawable/ic_category"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tv_supplier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Apple Inc"
                    android:drawableStart="@drawable/ic_suppliers"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/colorPrimary" />
            </LinearLayout>

            <!-- Description -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Latest iPhone model with A17 Pro chip and titanium design."
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pricing Information -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pricing Information"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <!-- Selling Price -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selling Price:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_selling_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 1,500,000"
                            android:textColor="@color/green_success"
                            android:textStyle="bold" />

                        <!-- Cost Price -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cost Price:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_cost_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 1,200,000"
                            android:textColor="@color/text_primary" />

                        <!-- Profit Margin -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profit Margin:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:id="@+id/tv_profit_margin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20%"
                            android:textColor="@color/colorPrimary"
                            android:textStyle="bold" />
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stock Information -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock Information"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <!-- Current Stock -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Stock:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_current_stock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 units"
                            android:textColor="@color/colorPrimary"
                            android:textStyle="bold" />

                        <!-- Low Stock Threshold -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low Stock Alert:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_low_stock_threshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 units"
                            android:textColor="@color/red_error" />

                        <!-- Stock Status -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:id="@+id/tv_stock_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Healthy Stock"
                            android:textColor="@color/green_success"
                            android:textStyle="bold" />
                    </GridLayout>

                    <!-- Progress Bar for Stock Level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stock Level"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="4dp" />

                        <ProgressBar
                            android:id="@+id/progress_stock"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="75"
                            android:max="100"
                            android:progressTint="@color/green_success" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Additional Details -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Additional Details"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3">

                        <!-- Barcode -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Barcode:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_barcode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="123456789012" />

                        <!-- Location -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tv_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aisle 3, Shelf B" />

                        <!-- Tax Rate -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tax Rate:"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:id="@+id/tv_tax_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18% VAT" />
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Edit Product"
                    app:icon="@drawable/ic_edit"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Restock"
                    app:icon="@drawable/ic_restock"
                    style="@style/Widget.Material3.Button" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>