<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    tools:context=".fragments.ReceiptFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Receipt"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:menu="@menu/menu_receipt" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Success Animation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_success"
                    android:background="@drawable/circle_background_green"
                    android:padding="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Successful!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_success"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Receipt Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Store Header with Shop Details - ENHANCED -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/shop_header_background"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_store"
                            android:tint="@color/colorPrimary"
                            android:layout_marginBottom="8dp" />

                        <!-- Shop Name - MUCH BIGGER AND BOLDER (40sp) -->
                        <TextView
                            android:id="@+id/tv_shop_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AK SHOPPERS"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary"
                            android:textAlignment="center"
                            android:letterSpacing="0.05"
                            android:shadowColor="#33000000"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4"
                            android:paddingVertical="4dp"
                            android:layout_marginBottom="4dp" />

                        <!-- Business Type - Now visible with styling -->
                        <TextView
                            android:id="@+id/tv_business_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RETAIL STORE"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimaryDark"
                            android:textAlignment="center"
                            android:background="@color/light_gray"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_marginVertical="8dp"
                            android:visibility="gone" />

                        <!-- Shop Address - Enhanced -->
                        <TextView
                            android:id="@+id/tv_shop_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kiwatule, Kampala"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="normal"
                            android:layout_marginTop="4dp"
                            android:textAlignment="center"
                            android:paddingHorizontal="8dp" />

                        <!-- Shop Phone - Enhanced -->
                        <TextView
                            android:id="@+id/tv_shop_contact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tel: +256 700 000000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary"
                            android:layout_marginTop="8dp"
                            android:textAlignment="center"
                            android:background="@drawable/phone_background"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:visibility="visible" />
                    </LinearLayout>

                    <!-- Divider with style -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/dashed_line"
                        android:layout_marginBottom="16dp" />

                    <!-- Receipt Info in a nice card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/light_gray"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="2dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Receipt No:"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tv_receipt_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="INV-20250215-001"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date:"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tv_receipt_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Feb 15, 2026"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Customer Info with icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/colorPrimaryLight"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="2dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_customer"
                            android:tint="@color/colorPrimary"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_customer_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Walk-in Customer"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_customer_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="N/A"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Items Header with better styling and alignment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:background="@color/colorPrimary"
                        android:elevation="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="ITEM"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:paddingStart="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="QTY"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PRICE"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="end"
                            android:paddingEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="end"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                    <!-- Items List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_receipt_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginVertical="8dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/dashed_line"
                        android:layout_marginVertical="16dp" />

                    <!-- Summary with better spacing and alignment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@color/light_gray"
                        android:elevation="2dp">

                        <!-- Subtotal -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Subtotal"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UGX 0"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- Discount -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Discount"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_discount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-UGX 0"
                                android:textColor="@color/green_success"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- Tax -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tax"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_tax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UGX 0"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:gravity="end" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginVertical="8dp" />

                        <!-- Total -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="TOTAL"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UGX 0"
                                android:textSize="24sp"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- Paid -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Paid"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_paid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UGX 0"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- Change -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Change"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_change"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UGX 0"
                                android:textSize="14sp"
                                android:textColor="@color/green_success"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Payment Method with icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="@color/colorPrimaryLight"
                        android:elevation="2dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_payment"
                            android:tint="@color/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment Method:"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tv_payment_method"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary" />
                    </LinearLayout>

                    <!-- Footer with thank you message -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thank you for your purchase!"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Visit us again!"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="4dp" />

                        <!-- Shop Name in footer for branding -->
                        <TextView
                            android:id="@+id/tv_footer_shop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AK SHOPPERS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_print"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Print"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:icon="@drawable/ic_print"
                    app:iconGravity="textStart"
                    android:textColor="@color/colorPrimary"
                    app:strokeColor="@color/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Share"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    android:textColor="@color/colorPrimary"
                    app:strokeColor="@color/colorPrimary" />
            </LinearLayout>

            <!-- New Sale Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_sale"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="New Sale"
                android:backgroundTint="@color/colorPrimary"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>