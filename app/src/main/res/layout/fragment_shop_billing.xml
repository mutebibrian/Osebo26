<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Shop Name -->
        <TextView
            android:id="@+id/tvShopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shop Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <!-- Optional subtitle (shop code or location) -->
        <TextView
            android:id="@+id/tvShopLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <!-- Subscription Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHOP SUBSCRIPTION"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscription Overview"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <!-- Shop name (repeated for clarity) -->
                <TextView
                    android:id="@+id/tvShopNameSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intellectitech"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp"/>

                <!-- Active Bundles Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACTIVE BUNDLES"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.04"/>

                    <TextView
                        android:id="@+id/tvActiveBundles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <!-- Subscription Status -->
                <TextView
                    android:id="@+id/tvSubscriptionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INACTIVE"
                    android:textSize="14sp"
                    android:textColor="@color/error"
                    android:layout_marginBottom="16dp"/>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <!-- Left Button: Manage/Start Trial -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageBundles"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="+ Manage Bundles"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <!-- Right Button: Renew -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRenewBundles"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Renew Bundles"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        style="@style/Widget.Material3.Button"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- No Active Subscriptions Message -->
        <TextView
            android:id="@+id/tvNoActiveSubscriptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="No active subscriptions found for this shop."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/bg_rounded_light"
            android:visibility="gone"/>

        <!-- Bottom spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp"/>

    </LinearLayout>
</ScrollView>