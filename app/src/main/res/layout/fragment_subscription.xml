<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_grey">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Progress Bar - Loading State -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            tools:visibility="visible" />

        <!-- Error Text - Error State -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Failed to load subscription data"
            android:textColor="@color/error_red"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <!-- Retry Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Retry"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/errorText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <!-- Current Subscription Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/currentSubscriptionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/shopBillingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shop Billing"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/shopBillingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscription Management"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/shopBillingTitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Tab Layout -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/subscriptionTabs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:tabSelectedTextColor="@color/primary_color"
                    app:tabTextColor="@color/grey_600"
                    app:tabIndicatorColor="@color/primary_color"
                    app:layout_constraintTop_toBottomOf="@id/shopBillingSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overview" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History" />

                </com.google.android.material.tabs.TabLayout>

                <!-- ViewPager2 for Tab Content -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/subscriptionTabs"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Current Subscription Details -->
                <TextView
                    android:id="@+id/currentSubscriptionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Subscription"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/viewPager"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/subscriptionDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:background="@color/primary_light"
                    app:layout_constraintTop_toBottomOf="@id/currentSubscriptionTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- First Row: Package and Max -->
                    <TextView
                        android:id="@+id/packageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Package"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/packageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/packageLabel"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/maxLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        app:layout_constraintTop_toTopOf="@id/packageLabel"
                        app:layout_constraintStart_toEndOf="@id/packageLabel"
                        android:layout_marginStart="48dp" />

                    <TextView
                        android:id="@+id/maxValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 month"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/maxLabel"
                        app:layout_constraintStart_toEndOf="@id/packageValue"
                        android:layout_marginStart="48dp" />

                    <!-- Second Row: Expires and Days Left -->
                    <TextView
                        android:id="@+id/expiresLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        app:layout_constraintTop_toBottomOf="@id/packageValue"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/expiresValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jan 10, 2026"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        app:layout_constraintTop_toBottomOf="@id/expiresLabel"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/daysLeftLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Days Left"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        app:layout_constraintTop_toTopOf="@id/expiresLabel"
                        app:layout_constraintStart_toEndOf="@id/expiresLabel"
                        android:layout_marginStart="48dp" />

                    <TextView
                        android:id="@+id/daysLeftValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/error_red"
                        app:layout_constraintTop_toBottomOf="@id/daysLeftLabel"
                        app:layout_constraintStart_toEndOf="@id/expiresValue"
                        android:layout_marginStart="48dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/success_green"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/removeSubscriptionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove Subscription"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@color/error_red"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/subscriptionDetails"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Available Plans Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/plansCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/currentSubscriptionCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/availablePlansTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Plans"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Plans RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/plansRecyclerView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/availablePlansTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Custom Plan Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/customPlanCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/primary_light"
                    app:layout_constraintTop_toBottomOf="@id/plansRecyclerView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/customPlanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LET'S CHAT"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_color"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/customPlanSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom pricing available"
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:layout_marginTop="4dp"
                            app:layout_constraintTop_toBottomOf="@id/customPlanTitle"
                            app:layout_constraintStart_toStartOf="parent" />

                        <LinearLayout
                            android:id="@+id/featuresLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@id/customPlanSubtitle"
                            app:layout_constraintStart_toStartOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Inventory"
                                android:textSize="14sp"
                                android:textColor="@color/grey_700" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Reports"
                                android:textSize="14sp"
                                android:textColor="@color/grey_700"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Support"
                                android:textSize="14sp"
                                android:textColor="@color/grey_700"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ API"
                                android:textSize="14sp"
                                android:textColor="@color/grey_700"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/contactSalesButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Contact Sales"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:layout_constraintTop_toBottomOf="@id/featuresLayout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>