<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_grey"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Shop Info Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shops · Shop Billing"
                android:textSize="14sp"
                android:textColor="@color/grey_600"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BK Enterprise"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                tools:text="BK Enterprise" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="16dp">

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Error Text -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error loading plans"
                android:textColor="@color/error_red"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:visibility="gone" />

            <!-- Retry Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:layout_constraintTop_toBottomOf="@id/errorText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="gone" />

            <!-- No Subscription State -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/noSubscriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/emptyStateImage"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_subscription_empty"
                    android:tint="@color/grey_400"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="60dp" />

                <TextView
                    android:id="@+id/emptyStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Active Subscription"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/grey_700"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/emptyStateImage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/emptyStateSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscribe to a plan to access all features"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/emptyStateTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subscribeNowButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscribe Now"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/emptyStateSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Subscription Details -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/subscriptionDetailsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Plan Name and Status Chip -->
                <LinearLayout
                    android:id="@+id/planHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/planNameTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pro Plan"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        tools:text="Pro Plan" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        app:chipBackgroundColor="@color/success_green"
                        android:textColor="@color/white"
                    app:chipCornerRadius="16dp"
                    android:textSize="12sp"
                    tools:text="Active" />
                </LinearLayout>

                <!-- Price -->
                <TextView
                    android:id="@+id/priceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UGX 20,000 / month"
                    android:textSize="20sp"
                    android:textColor="@color/primary_color"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/planHeader"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Expiry Section -->
                <LinearLayout
                    android:id="@+id/expirySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/priceTextView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expires"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/expiresValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mar 19, 2026"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        tools:text="Mar 19, 2026" />
                </LinearLayout>

                <!-- Days Left Section -->
                <LinearLayout
                    android:id="@+id/daysLeftSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/expirySection"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Days Left"
                        android:textSize="14sp"
                        android:textColor="@color/grey_600"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/daysLeftValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/success_green"
                        tools:text="14" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey_200"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/daysLeftSection"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Subscription Details Table -->
                <TextView
                    android:id="@+id/startDateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Date:"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/startDateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dec 10, 2025"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/startDateLabel"
                    app:layout_constraintStart_toEndOf="@id/startDateLabel"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/startDateLabel" />

                <TextView
                    android:id="@+id/endDateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End Date:"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/startDateLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/endDateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jan 10, 2026"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/endDateLabel"
                    app:layout_constraintStart_toEndOf="@id/endDateLabel"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/endDateLabel" />

                <TextView
                    android:id="@+id/daysLeftLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Days Left:"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/endDateLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/daysLeftTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 days"
                    android:textSize="14sp"
                    android:textColor="@color/error_red"
                    app:layout_constraintTop_toTopOf="@id/daysLeftLabel"
                    app:layout_constraintStart_toEndOf="@id/daysLeftLabel"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/daysLeftLabel" />

                <TextView
                    android:id="@+id/statusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status:"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/daysLeftLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="14sp"
                    android:textColor="@color/success_green"
                    app:layout_constraintTop_toTopOf="@id/statusLabel"
                    app:layout_constraintStart_toEndOf="@id/statusLabel"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/statusLabel" />

                <TextView
                    android:id="@+id/autoRenewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Renew:"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/statusLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/autoRenewTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/autoRenewLabel"
                    app:layout_constraintStart_toEndOf="@id/autoRenewLabel"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/autoRenewLabel" />

                <TextView
                    android:id="@+id/paymentMethodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method:"
                    android:textSize="14sp"
                    android:textColor="@color/grey_600"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/autoRenewLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/paymentMethodTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Money"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/paymentMethodLabel"
                    app:layout_constraintStart_toEndOf="@id/paymentMethodLabel"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/paymentMethodLabel" />

                <!-- Action Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/upgradePlanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Upgrade Plan"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/paymentMethodLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/renewButton"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/renewButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Renew"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:layout_constraintTop_toTopOf="@id/upgradePlanButton"
                    app:layout_constraintStart_toEndOf="@id/upgradePlanButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/upgradePlanButton" />

                <!-- Alternative Renew Button (matches image) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/renewShopSubscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Renew Shop Subscription"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/renewButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Available Plans Section -->
            <TextView
                android:id="@+id/plansSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Plans"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/subscriptionDetailsLayout"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Plans RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/plansRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/plansSectionTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Contact Sales Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contactSalesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/plansRecyclerView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_sales"
                        android:tint="@color/primary_color"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Need a custom plan?"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact our sales team for enterprise solutions"
                            android:textSize="12sp"
                            android:textColor="@color/grey_600" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/contactSalesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contact"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>