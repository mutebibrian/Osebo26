<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Choose a Plan"
            app:titleTextColor="@color/on_surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:background="@android:color/transparent"
            app:elevation="0dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_error"
                    android:contentDescription="Error"
                    android:tint="@color/error"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Failed to load packages"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retry"
                    style="@style/Widget.Material3.Button" />

            </LinearLayout>

            <!-- Content Layout -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Current Plan (for upgrades) -->
                <TextView
                    android:id="@+id/tvCurrentPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current: Basic Plan"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_variant"
                    android:background="@drawable/bg_current_plan"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone" />

                <!-- Packages List - Expanded to use available space -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPackages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="32dp" />

                <!-- Selected Package Details -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSelectedPackage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvSelectedPackageName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pro Plan"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvSelectedPackagePrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UGX 50,000/month"
                            android:textSize="16sp"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvSelectedPackageDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Advanced features for growing businesses"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Trial Info -->
                        <LinearLayout
                            android:id="@+id/layoutTrialInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_trial"
                                android:contentDescription="Trial"
                                android:layout_marginEnd="8dp"
                                app:tint="@color/blue_500" />

                            <TextView
                                android:id="@+id/tvTrialDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 days free trial"
                                android:textSize="14sp"
                                android:textColor="@color/blue_500" />

                        </LinearLayout>

                        <!-- Features List -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Features:"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutFeatures"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContinue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SELECT A PLAN TO CONTINUE"
                        android:enabled="false"
                        style="@style/Widget.Material3.Button"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SKIP FOR NOW"
                        style="@style/Widget.Material3.Button.TextButton" />

                    <!-- REMOVED: progressBarCreate - removed completely -->

                </LinearLayout>

                <!-- Info Text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="All plans include 24/7 support and regular updates"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:gravity="center"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>