<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Device Icon -->
        <ImageView
            android:id="@+id/deviceIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_device"
            android:tint="@color/primary_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Current Session Badge -->
        <TextView
            android:id="@+id/currentSessionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_current_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/deviceIcon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Device Name -->
        <TextView
            android:id="@+id/deviceNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Samsung Galaxy S21"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="@id/deviceIcon"
            app:layout_constraintStart_toEndOf="@id/deviceIcon"
            app:layout_constraintEnd_toStartOf="@id/currentSessionBadge"
            android:layout_marginStart="12dp" />

        <!-- Browser -->
        <TextView
            android:id="@+id/browserTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Chrome 120.0"
            android:textSize="14sp"
            android:textColor="@color/grey_600"
            app:layout_constraintTop_toBottomOf="@id/deviceNameTextView"
            app:layout_constraintStart_toStartOf="@id/deviceNameTextView"
            app:layout_constraintEnd_toEndOf="@id/deviceNameTextView"
            android:layout_marginTop="2dp" />

        <!-- IP Address -->
        <TextView
            android:id="@+id/ipAddressTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="IP: 192.168.1.100"
            android:textSize="12sp"
            android:textColor="@color/grey_500"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/browserTextView"
            app:layout_constraintStart_toStartOf="@id/deviceNameTextView"
            app:layout_constraintEnd_toStartOf="@id/locationTextView" />

        <!-- Location -->
        <TextView
            android:id="@+id/locationTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kampala, UG"
            android:textSize="12sp"
            android:textColor="@color/grey_500"
            app:layout_constraintTop_toTopOf="@id/ipAddressTextView"
            app:layout_constraintEnd_toEndOf="@id/deviceNameTextView"
            app:layout_constraintBottom_toBottomOf="@id/ipAddressTextView" />

        <!-- Last Active -->
        <TextView
            android:id="@+id/lastActiveTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 hours ago"
            android:textSize="12sp"
            android:textColor="@color/grey_500"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ipAddressTextView"
            app:layout_constraintStart_toStartOf="@id/deviceNameTextView" />

        <!-- Terminate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/terminateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terminate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/error_red"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ipAddressTextView"
            app:layout_constraintEnd_toEndOf="@id/deviceNameTextView"
            app:layout_constraintBottom_toBottomOf="@id/lastActiveTextView" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>