<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.MaterialComponents.Dark"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:clickable="false"
        android:focusable="false">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/iv_app_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/oseboicon"
            android:layout_marginEnd="12dp"
            app:tint="@color/white" />

        <!-- App Name and Subscription Badge -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Osebo"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <!-- Subscription Badge -->
            <TextView
                android:id="@+id/tv_subscription_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="4dp"
                android:text="ACTIVE"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_subscription_badge"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.2.0 (Build 305)"
                android:textColor="@color/white_alpha_70"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- User Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="false"
        android:focusable="false">

        <!-- User Avatar - REMOVE CLICKABLE/FOCUSABLE -->
        <LinearLayout
            android:id="@+id/ll_user_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_user_avatar"
            android:gravity="center"
            android:layout_marginEnd="12dp"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/tv_user_initial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- User Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin User"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="admin@powerlipay.com"
                android:textColor="@color/white_alpha_70"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

            <!-- Viewing Mode Indicator (NEW) -->
            <TextView
                android:id="@+id/tv_viewing_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white_alpha_70"
                android:textSize="11sp"
                android:textStyle="italic"
                android:visibility="gone"
                android:layout_marginTop="4dp" />

            <!-- Current Shop with Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_store"
                    android:tint="@color/white_alpha_70"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tv_current_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Shop Selected"
                    android:textColor="@color/white_alpha_70"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:drawablePadding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings Icon - REMOVE CLICKABLE/FOCUSABLE & selectableItemBackground -->
        <ImageView
            android:id="@+id/iv_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings_24"
            android:padding="4dp"
            android:clickable="false"
            android:focusable="false"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Optional: Divider for visual separation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_alpha_20"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

</LinearLayout>